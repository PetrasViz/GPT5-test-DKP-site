Options +FollowSymLinks
RewriteEngine On

# Serve real files and directories in /public directly (css, js, images)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Otherwise hand everything to index.php (your router)
RewriteRule ^ index.php [L]

# Ensure index files work in /public
DirectoryIndex index.php index.html
