# Use the public folder's index for the homepage
DirectoryIndex public/index.php

RewriteEngine On

# If someone browses /public directly, canonicalize to /
RewriteCond %{REQUEST_URI} ^/public/?(.*)$ [NC]
RewriteRule ^public/?(.*)$ /$1 [R=301,L]

# Serve existing files/dirs in root as-is (rare, but safe)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Internally map everything to /public/… (assets and routes)
RewriteRule ^(.*)$ public/$1 [L]
